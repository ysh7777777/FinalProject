@model List<FinalProject.Models.ProjectImage>
@{
    ViewData["Title"] = "首頁";
    ViewData["PageClass"] = "home-index";
    Layout = "~/Views/Shared/Client_Layout.cshtml";
    var heroSlides =
       Model ?? new List<FinalProject.Models.ProjectImage>();
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/Home/StyleSheet.css"
          asp-append-version="true" />
}

    <!-- Header 請使用你原本的 Layout -->

@if (heroSlides.Count == 0)
{
    <div class="container py-5">
        <div class="alert alert-info mb-0" role="status">
            目前沒有可顯示的首頁輪播圖片。
        </div>
    </div>
}
else
{
    <section class="hero" aria-label="首頁圖片輪播">
        <div id="heroCarousel"
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="5000"
             data-bs-pause="hover"
             data-bs-touch="true">

            @* 修改 4：使用迴圈產生下方指示點 *@
            <div class="carousel-indicators mb-4">
                @for (var i = 0; i < heroSlides.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#heroCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="顯示第 @(i + 1) 張">
                    </button>
                }
            </div>

            @* 修改 5：使用迴圈產生輪播圖片 *@
            <div class="carousel-inner">
                @for (var i = 0; i < heroSlides.Count; i++)
                {
                    ProjectImage slide = heroSlides[i];

                    @* 修改 1：移除標題前面的「首頁輪播｜」 *@
                    string displayTitle = slide.ImageTitle ?? "機場接送";

                    int separatorIndex = displayTitle.IndexOf('｜');

                    if (separatorIndex >= 0)
                    {
                        displayTitle = displayTitle.Substring(separatorIndex + 1);
                    }

                    @* 修改 2：依照輪播順序設定不同按鈕文字 *@
                    string buttonText = i switch
                    {
                        0 => "立即預約接送",
                        1 => "查看詳細車輛",
                        2 => "貼心服務",
                        _ => "了解更多"
                    };

                    @* 修改 3：依照輪播順序設定按鈕連結 *@
                    string buttonLink = i switch
                    {
                        0 => "/Booking/Create",
                        1 => "#fleet",
                        2 => "#services",
                        _ => "#"
                    };

                    <div class="carousel-item @(i == 0 ? "active" : "")">

                        @* 修改 4：alt 改用移除前綴後的標題 *@
                        <img src="@Url.Content(slide.ImageUrl ?? "")"
                             class="d-block w-100 hero-image"
                             alt="@displayTitle" />

                        <div class="hero-overlay"></div>

                        <div class="container hero-caption">
                            <p class="eyebrow">
                                WAN MA AIRPORT TRANSFER
                            </p>

                            @* 修改 5：畫面不再顯示「首頁輪播」 *@
                            <h1>@displayTitle</h1>

                            <p class="hero-lead">
                                @slide.Description
                            </p>

                            @* 修改 6：使用每張輪播對應的按鈕文字和連結 *@
                            <a class="btn btn-light rounded-pill px-4 py-3 fw-bold"
                               href="@buttonLink">
                                @buttonText
                            </a>
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide="prev">

                <span class="carousel-control-prev-icon"
                      aria-hidden="true"></span>

                <span class="visually-hidden">上一張</span>
            </button>

            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide="next">

                <span class="carousel-control-next-icon"
                      aria-hidden="true"></span>

                <span class="visually-hidden">下一張</span>
            </button>
        </div>
    </section>
}

        <section class="story">
            <div class="container story-content">
                <p class="eyebrow">365 DAYS · 24 HOURS</p>
                <h2>接機不只是接送，更是旅程安心的開始</h2>
                <p class="story-lead">
                    從預約、出發到抵達，我們細心掌握每一段行程。無論是獨自旅行、家庭出遊，
                    或多人商務移動，都能享有準時、舒適且貼心的專車服務。
                </p>
                <ul class="story-points">
                    <li>專業駕駛</li>
                    <li>專車直達</li>
                    <li>行李安心</li>
                    <li>全天候預約</li>
                </ul>
            </div>
        </section>
        @* 大圖後 *@
