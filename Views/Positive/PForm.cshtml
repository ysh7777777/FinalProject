<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>行程評價</title>
    <!-- Bootstrap CSS -->
    <link href="/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet">
    <!-- Font Awesome (圖示) -->
    <link rel="stylesheet" href="~/css/Members/all.min.css">
    <!-- 自訂 CSS -->
    <link href="~/css/Members/PForm.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center min-vh-100">

    <div class="container d-flex justify-content-center">
        <div class="card rating-card shadow-sm p-4">

            <!-- 司機資訊區塊 -->
            <div class="driver-info">
                <div class="driver-avatar">
                    <i class="fa-solid fa-circle-user"></i>
                </div>
                <div class="driver-details">
                    <div class="driver-name">
                        陳大明 <span class="driver-title">司機</span>
                    </div>
                    <span class="driver-badge">ABC-1234 · 白色 Toyota</span>
                </div>
            </div>

            <!-- 行程路線 -->
            <div class="route-box">
                <i class="fa-solid fa-location-dot icon-start"></i>台北車站
                <i class="fa-solid fa-arrow-right icon-arrow"></i>
                <i class="fa-solid fa-location-dot icon-end"></i>市政府
            </div>

            <!-- 分隔線 -->
            <hr class="divider">

            <!-- 評分表單 -->
            <form action="/Rating/Submit" method="POST" class="text-center">
                <h5 class="fw-bold mb-3">您對本次行程滿意嗎？</h5>

                <!-- 滿版點擊星星區塊 (由 5 到 1 排列) -->
                <div class="star-rating mb-3">
                    <input type="radio" id="star5" name="rating" value="5" required />
                    <label for="star5" title="5星"><i class="fa-solid fa-star"></i></label>

                    <input type="radio" id="star4" name="rating" value="4" />
                    <label for="star4" title="4星"><i class="fa-solid fa-star"></i></label>

                    <input type="radio" id="star3" name="rating" value="3" />
                    <label for="star3" title="3星"><i class="fa-solid fa-star"></i></label>

                    <input type="radio" id="star2" name="rating" value="2" />
                    <label for="star2" title="2星"><i class="fa-solid fa-star"></i></label>

                    <input type="radio" id="star1" name="rating" value="1" />
                    <label for="star1" title="1星"><i class="fa-solid fa-star"></i></label>
                </div>

                <p class="text-muted small mb-3">覺得哪裡做得好呢？（可多選）</p>

                <!-- 快捷標籤區塊 -->
                <div class="tag-group">
                    <input type="checkbox" id="tag1" name="tags" value="駕駛平穩" autocomplete="off" class="tag-input">
                    <label class="tag-label" for="tag1">駕駛平穩</label>

                    <input type="checkbox" id="tag2" name="tags" value="車室清潔" autocomplete="off" class="tag-input">
                    <label class="tag-label" for="tag2">車室清潔</label>

                    <input type="checkbox" id="tag3" name="tags" value="車內無異味" autocomplete="off" class="tag-input">
                    <label class="tag-label" for="tag3">車內無異味</label>

                    <input type="checkbox" id="tag4" name="tags" value="親切禮貌" autocomplete="off" class="tag-input">
                    <label class="tag-label" for="tag4">親切禮貌</label>

                    <input type="checkbox" id="tag5" name="tags" value="路線熟悉" autocomplete="off" class="tag-input">
                    <label class="tag-label" for="tag5">路線熟悉</label>

                    <input type="checkbox" id="tag6" name="tags" value="溝通順暢" autocomplete="off" class="tag-input">
                    <label class="tag-label" for="tag6">溝通順暢</label>
                </div>

                <!-- 操作按鈕區塊 -->
                <div class="action-group">
                    <button type="submit" class="btn-submit">送出評價</button>
                    <a href="/" class="link-skip">跳過</a>
                </div>
            </form>

        </div>
    </div>
</body>
</html>