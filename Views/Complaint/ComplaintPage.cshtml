@model FinalProject.DTO.ComplaintViewModel

@{
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- 自訂 CSS -->
    <link rel="stylesheet" href="~/css/ComplaintPage/complaint.css">
</head>

<body>
    <div class="complaint-page">
        <div class="container py-4 py-md-5">
            <!-- ========================= 頁面標題 ========================= -->
            <div class="page-header mb-4">
                <div>
                    <h2 class="page-title">
                        <i class="bi bi-exclamation-circle"></i>
                        提出申訴
                    </h2>
                    <p class="page-description">
                        如果您在搭乘過程中遇到任何問題，請填寫以下資料，我們會盡快為您處理。
                    </p>
                </div>
            </div>
            <form asp-action="Submit" asp-controller="Complaint" method="post" enctype="multipart/form-data"
                  id="complaintForm">
                @Html.AntiForgeryToken()
                <!-- ========================= 訂單資訊 ========================= -->
                <div class="complaint-card mb-4">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div>
                            <h4>訂單資訊</h4>
                            <p>以下資訊由系統自動帶入</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <!-- 訂單編號 -->
                        <div class="col-12 col-md-6">
                            <div class="info-box">
                                <div class="info-title">
                                    <i class="bi bi-receipt"></i>
                                    訂單編號
                                </div>
                                <div class="info-value">
                                    @Model.OrderNoView
                                    <input type="hidden" asp-for="OrderNoView" />
                                </div>
                            </div>
                        </div>
                        <!-- 會員名稱 -->
                        <div class="col-12 col-md-6">
                            <div class="info-box">
                                <div class="info-title">
                                    <i class="bi bi-person"></i>
                                    會員名稱
                                </div>
                                <div class="info-value">
                                    @Model.FullNameView
                                    <input type="hidden" asp-for="AccountView" />
                                    <input type="hidden" asp-for="FullNameView" />
                                </div>
                            </div>
                        </div>
                        <!-- 聯絡電話 -->
                        <div class="col-12 col-md-6">
                            <div class="info-box">
                                <div class="info-title">
                                    <i class="bi bi-telephone"></i>
                                    聯絡電話
                                </div>
                                <div class="info-value">
                                    @Model.PhoneNumberView
                                </div>
                            </div>
                        </div>
                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <div class="info-box">
                                <div class="info-title">
                                    <i class="bi bi-envelope"></i>
                                    Email
                                </div>
                                <div class="info-value">
                                    @Model.EmailView
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- ========================= 申訴內容 ========================= -->
                <div class="complaint-card mb-4">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </div>
                        <div>
                            <h4>申訴內容</h4>
                            <p>請告訴我們您遇到的問題</p>
                        </div>
                    </div>
                    <!-- ========================= 申訴類型 ========================= -->
                    <div class="mb-4">
                        @* <label asp-for="ComplaintType" class="form-label custom-label"> *@
                        <label class="form-label custom-label">
                            申訴類型
                            <span class="required">*</span>
                        </label>
                        <select asp-for="ComplaintTypeView" class="form-select custom-select">
                        @* <select class="form-select custom-select"> *@
                            <option value="">
                                請選擇申訴類型
                            </option>
                            <option value="司機遲到/未到">
                                司機遲到 / 未到
                            </option>
                            <option value="車輛問題">
                                車輛問題
                            </option>
                            <option value="司機服務態度">
                                司機服務態度
                            </option>
                            <option value="行李損壞或遺失">
                                行李損壞或遺失
                            </option>
                            <option value="安全相關問題">
                                安全相關問題
                            </option>
                            <option value="其他">
                                其他
                            </option>
                        </select>
                        <span asp-validation-for="ComplaintTypeView" class="text-danger"></span>
                        @* <span class="text-danger"></span> *@
                    </div>
                    <!-- ========================= 問題說明 ========================= -->
                    <div class="mb-4">
                        <label asp-for="DescriptionView" class="form-label custom-label">
                        @* <label class="form-label custom-label"> *@
                            問題說明
                            <span class="required">*</span>
                        </label>
                        <textarea asp-for="DescriptionView" class="form-control custom-textarea" rows="6" maxlength="1000"
                        @* <textarea class="form-control custom-textarea" rows="6" maxlength="1000" *@
                                  placeholder="請詳細描述您遇到的問題，例如發生時間、地點及相關情況..."></textarea>
                        <div class="textarea-footer">
                            <span asp-validation-for="DescriptionView" class="text-danger"></span>
                            @* <span class="text-danger"></span> *@
                            <span id="charCount">
                                0 / 1000
                            </span>
                        </div>
                    </div>
                </div>
                <!-- ========================= 上傳圖片 ========================= -->
                <div class="complaint-card mb-4">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-images"></i>
                        </div>
                        <div>
                            <h4>相關圖片</h4>
                            <p>如有相關照片，可以上傳協助我們了解問題</p>
                        </div>
                    </div>
                    <div class="upload-area" id="uploadArea">
                        <i class="bi bi-cloud-arrow-up upload-icon"></i>
                        <h5>
                            上傳相關圖片
                        </h5>
                        <p>
                            點擊選擇圖片，或將圖片拖曳至此處
                        </p>
                        <small>
                            支援 JPG、JPEG、PNG，單張最大 5MB
                        </small>
                        <label for="imageInput" class="btn btn-upload">
                            <i class="bi bi-image"></i>
                            選擇圖片
                        </label>
                        @* <input asp-for="Images" type="file" id="imageInput" class="d-none" accept="image/jpeg,image/png" multiple /> *@
                        <input type="file" id="imageInput" name="ImagesView" class="d-none" accept="image/jpeg,image/png" />
                    </div>
                    <!-- 圖片預覽 -->
                    <div id="previewContainer" class="row g-3 mt-3">
                    </div>
                </div>
                <!-- ========================= 提示 ========================= -->
                <div class="complaint-notice mb-4">
                    <i class="bi bi-info-circle"></i>
                    <div>
                        <strong>提醒您</strong>
                        <p>
                            請確認您填寫的申訴內容及聯絡資訊正確。
                            我們收到申訴後將會進行確認，必要時可能會與您聯繫。
                        </p>
                    </div>
                </div>
                <!-- ========================= 送出按鈕 ========================= -->
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary-custom" onclick="history.back()">
                        <i class="bi bi-arrow-left"></i>
                        返回
                    </button>
                    <button type="submit" class="btn btn-submit">
                        <i class="bi bi-send"></i>
                        送出申訴
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================= JS ======================== -->
    <script src="~/js/ComplaintPage/complaint.js"></script>

</body>

</html>