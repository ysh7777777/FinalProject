                            </div>
                            <div class="summary-value" id="summaryCar">
                                尚未選擇
                            </div>
                        </div>
                        <!-- 預估里程數 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-signpost-2"></i>
                                預估里程數
                            </div>
                            <div class="summary-value" id="summaryEstimatedDistance">
                                尚未計算
                            </div>
                        </div>
                        <!-- 預估行程時間 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-clock"></i>
                                預估行程時間
