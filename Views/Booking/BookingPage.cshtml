<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>機場接送預約</title>

    <!-- ======================= Bootstrap 5.3.3 ======================= -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- ======================= Bootstrap Icons ======================= -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- ======================= Flatpickr ======================= -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <!-- ======================= Google Font ======================= -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- ======================= CSS ======================= -->
    <link rel="stylesheet" href="~/css/Booking/0810.css">
</head>

<body>
@*  測試連接資料庫用(成功)
    @foreach (var driver in Drivers)
    {
    <p>@driver.DriverId - @driver.DriverName</p>
    }
    @foreach (var VehicleImg in VehicleMenu)
    {
        <div>@VehicleImg.VehicleType - @VehicleImg.ImageUrl</div>
    }
*@

    <!-- ======================= << Header >> ======================= -->
    @* <header class="site-header">
        <nav class="navbar">
            <div class="container">
                <a href="#" class="navbar-brand">
                    <i class="bi bi-airplane-engines-fill"></i>
                    機場接送
                </a>
            </div>
        </nav>
    </header> *@

    <!-- ======================= Main ======================= -->
    <main class="booking-page">

        <h1 class="page-title">
            機場接送預約
        </h1>

        <!-- 測試寬及RWD用
        <div class="row">
            <div class="col-12">
                <p class="bi bi-calendar-event" style="background-color: black;"></p>
                乘車時間
            </div>
        </div>
        -->
        <div class="row">
        <form id="bookingForm" class="booking-form" novalidate>
            <!-- ======================= 主要表單 div ======================= -->
            <div class="col-12">
                <!-- ======================= 乘車時間 section ======================= -->
                <section class="booking-card">
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-calendar-event"></i>
                            乘車時間
                        </h2>
                    </div>
                    <div class="booking-card-body">
                        <div class="ride-time-row">
                            <!-- 日期 -->
                            <div class="date-field">
                                <label for="rideDate" class="form-label">
                                    日期
                                </label>
                                <input type="text" id="rideDate" class="form-control" placeholder="請選擇日期"
                                       autocomplete="off">
                            </div>
                            <!-- 小時 -->
                            <div>
                                <label for="rideHour" class="form-label">
                                    時
                                </label>
                                <select id="rideHour" class="form-select">
                                    <option value="">時</option>
                                </select>
                            </div>
                            <!-- 分鐘 -->
                            <div>
                                <label for="rideMinute" class="form-label">
                                    分
                                </label>
                                <select id="rideMinute" class="form-select">
                                    <option value="">分</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ======================= 上下車地點 section ======================= -->
                <section class="booking-card location-card">
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-geo-alt-fill"></i>
                            搭乘地點
                        </h2>
                    </div>
                    <div class="booking-card-body">
                        <!-- ======================= 上車地點 div ======================= -->
                        <div class="location-block" id="pickupLocation">
                            <div class="location-title">
                                <span class="location-icon">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                上車地點
                            </div>
                            <!-- 上車地點類型 div -->
                            <div class="location-type-switch" role="group">
                                <button type="button" class="btn active" data-location="pickup" data-type="api">
                                    API 搜尋
                                </button>
                                <button type="button" class="btn" data-location="pickup" data-type="favorite">
                                    常用地址
                                </button>
                                <button type="button" class="btn" data-location="pickup" data-type="airport">
                                    機場
                                </button>
                            </div>
                            <!-- 上車：API 搜尋 -->
                            <div id="pickupApiPanel" class="city-panel">
                                <div class="row g-3">
                                    <!-- 保留組員欄位供後續相容，但不在叫車頁顯示。 -->
                                    <div class="d-none-custom" aria-hidden="true">
                                        <label for="pickupCity" class="form-label">
                                            縣市
                                        </label>
                                        <select id="pickupCity" class="form-select">
                                            <option value="">請選擇縣市</option>
                                        </select>
                                        <label for="pickupDistrict" class="form-label">
                                            行政區
                                        </label>
                                        <select id="pickupDistrict" class="form-select" disabled>
                                            <option value="">請先選擇縣市</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">
                                            上車地址
                                        </label>
                                        <div id="pickup-autocomplete-container"></div>
                                        <input type="hidden" id="pickupAddress">
                                    </div>
                                </div>
                            </div>
                            <!-- 上車：常用地址 -->
                            <div id="pickupFavoritePanel" class="city-panel d-none-custom">
                                <label class="form-label" for="pickupFavorite">常用地址</label>
                                <select id="pickupFavorite" class="form-select">
                                    <option value="">請選擇常用地址</option>
                                    @foreach (var address in SavedAddresses)
                                    {
                                        <option value="@address.AddressId"
                                                data-address="@address.AddressText"
                                                data-lat="@(address.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                data-lng="@(address.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                            @address.Label｜@address.AddressText
                                        </option>
                                    }
                                </select>
                                @if (SavedAddresses.Count == 0)
                                {
                                    <div class="form-text">目前沒有常用地址，請至會員專區的常用地址維護新增。</div>
                                }
                            </div>
                            <!-- ======================= 上車：機場 div ======================= -->
                            <div id="pickupAirportPanel" class="airport-panel d-none-custom">
                                <div class="row g-3">
                                    <!-- 機場 div -->
                                    <div class="col-md-6">
                                        <label for="pickupAirport" class="form-label">
                                            機場
                                        </label>
                                        <select id="pickupAirport" class="form-select">
                                            <option value="">請選擇機場</option>
                                        </select>
                                    </div>
                                    <!-- 航廈 div -->
                                    <div class="col-md-6">
                                        <label for="pickupTerminal" class="form-label">
                                            航廈
                                        </label>
                                        <select id="pickupTerminal" class="form-select" disabled>
                                            <option value="">請先選擇機場</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- ======================= 上下車互換 div ======================= -->
                        @* <div class="swap-wrapper">
                            <button type="button" id="swapLocationBtn" class="swap-btn" title="交換上車與下車地點">
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </div> *@
                        <!-- ======================= 下車地點 div ======================= -->
                        <div class="location-block" id="dropoffLocation">
                            <div class="location-title">
                                <span class="location-icon">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </span>
                                下車地點
                            </div>
                            <!-- 下車地點類型 div -->
                            <div class="location-type-switch" role="group">
                                <button type="button" class="btn active" data-location="dropoff" data-type="api">
                                    API 搜尋
                                </button>
                                <button type="button" class="btn" data-location="dropoff" data-type="favorite">
                                    常用地址
                                </button>
                                <button type="button" class="btn" data-location="dropoff" data-type="airport">
                                    機場
                                </button>
                            </div>
                            <!-- 下車：API 搜尋 -->
                            <div id="dropoffApiPanel" class="city-panel">
                                <div class="row g-3">
                                    <!-- 保留組員欄位供後續相容，但不在叫車頁顯示。 -->
                                    <div class="d-none-custom" aria-hidden="true">
                                        <label for="dropoffCity" class="form-label">
                                            縣市
                                        </label>
                                        <select id="dropoffCity" class="form-select">
                                            <option value="">請選擇縣市</option>
                                        </select>
                                        <label for="dropoffDistrict" class="form-label">
                                            行政區
                                        </label>
                                        <select id="dropoffDistrict" class="form-select" disabled>
                                            <option value="">請先選擇縣市</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">
                                            下車地址
                                        </label>
                                        <div id="destination-autocomplete-container"></div>
                                        <input type="hidden" id="dropoffAddress">
                                    </div>
                                </div>
                            </div>
                            <!-- 下車：常用地址 -->
                            <div id="dropoffFavoritePanel" class="city-panel d-none-custom">
                                <label class="form-label" for="dropoffFavorite">常用地址</label>
                                <select id="dropoffFavorite" class="form-select">
                                    <option value="">請選擇常用地址</option>
                                    @foreach (var address in SavedAddresses)
                                    {
                                        <option value="@address.AddressId"
                                                data-address="@address.AddressText"
                                                data-lat="@(address.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                data-lng="@(address.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                            @address.Label｜@address.AddressText
                                        </option>
                                    }
                                </select>
                                @if (SavedAddresses.Count == 0)
                                {
                                    <div class="form-text">目前沒有常用地址，請至會員專區的常用地址維護新增。</div>
                                }
                            </div>
                            <!-- ======================= 下車：機場 div ======================= -->
                            <div id="dropoffAirportPanel" class="airport-panel d-none-custom">
                                <div class="row g-3">
                                    <!-- 機場 div -->
                                    <div class="col-md-6">
                                        <label for="dropoffAirport" class="form-label">
                                            機場
                                        </label>
                                        <select id="dropoffAirport" class="form-select">
                                            <option value="">請選擇機場</option>
                                        </select>
                                    </div>
                                    <!-- 航廈 div -->
                                    <div class="col-md-6">
                                        <label for="dropoffTerminal" class="form-label">
                                            航廈
                                        </label>
                                        <select id="dropoffTerminal" class="form-select" disabled>
                                            <option value="">請先選擇機場</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ======================= 增加停靠 section ======================= -->
                <section class="booking-card" style="display:none">
                    @* 讓停靠點section隱藏 *@
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-signpost-split"></i>
                            增加停靠
                        </h2>
                    </div>

                    <div class="booking-card-body">

                        <!-- 動態增減停靠點容器(JavaScript 執行) div -->
                        <div id="stopoverContainer" class="stopover-container"></div>

                        <!-- 沒有停靠點時顯示 div -->
                        <div id="stopoverEmpty" class="stopover-empty d-none">
                            <i class="bi bi-signpost-2"></i>
                            <span>
                                尚未增加停靠點
                            </span>
                        </div>

                        <!-- 最下面的新增停靠點按鈕 div -->
                        <div class="stopover-add-wrapper">
                            <button type="button" id="btnAddStop" class="btn btn-primary stopover-add-btn">
                                <i class="bi bi-plus-lg"></i>
                                增加停靠點
                            </button>
                        </div>
                    </div>
                </section>

                <!-- ======================= 選擇車型 section ======================= -->
                <!-- 新 -->
                <section class="booking-card" id="carSection">
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-car-front-fill"></i>
                            選擇車型
                        </h2>
                        <span class="booking-card-hint">
                            請選擇搭乘車型
                        </span>
                    </div>
                    <div class="booking-card-body">
                        <div class="row g-3">
                                <!-- 車型卡：foreach將資料庫的資料載入-->
                            @foreach (var Car in VehicleMenu)
                            {
                                <div class="col-12 col-sm-6 col-lg-4 col-xl-4">
                                        <div class="car-card" tabindex="0" data-car-id="standard" data-car-name="@Car.VehicleType"
                                         data-passengers="@Car.MaxPassengers" data-luggage="@Car.MaxLuggage" data-price="@Car.BaseFare">
                                        <!-- 選取狀態 -->
                                        <div class="car-selected-check">
                                            <i class="bi bi-check-lg"></i>
                                        </div>
                                        <!-- 車輛圖片 -->
                                        <div class="car-image-wrapper">
                                                <img src="@Car.ImageUrl" alt="@Car.ImageTitle" class="car-image">
                                        </div>
                                        <!-- 車型內容 -->
                                        <div class="car-card-body">
                                            <h3 class="car-name"> @Car.VehicleType </h3>
                                            <div class="car-description"> @Car.Description </div>
                                            <!-- 人數 / 行李 -->
                                            <div class="car-spec-list">
                                                <div class="car-spec">
                                                    <i class="bi bi-person-fill"></i>
                                                    <span> @Car.MaxPassengers 人 </span>
                                                </div>
                                                <div class="car-spec">
                                                    <i class="bi bi-luggage-fill"></i>
                                                    <span> @Car.MaxLuggage 件 </span>
                                                </div>
                                            </div>
                                            <!-- 價格 -->
                                            <div class="car-price-wrapper">
                                                <span class="car-price-label"> 接送價格 </span>
                                                <span class="car-price"> NT$ @Car.BaseFare <span class="car-price-unit"> 起 </span> </span>
                                            </div>
                                            <!-- 選擇按鈕 -->
                                            <div class="car-select-status"> <i class="bi bi-circle"></i> 選擇此車型 </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <!-- 車型卡：保留範本
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-4">
                                <div class="car-card" tabindex="0" data-car-id="standard" data-car-name="一般轎車"
                                     data-passengers="3" data-luggage="2" data-price="1200">
                                    @*選取狀態*@
                                    <div class="car-selected-check">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    @*車輛圖片*@
                                    <div class="car-image-wrapper">
                                        <img src="~/Images/CarMenu/五人座休旅車.png" alt="一般轎車" class="car-image">
                                    </div>
                                    @*車型內容*@
                                    <div class="car-card-body">
                                        <h3 class="car-name"> 一般轎車 </h3>
                                        <div class="car-description"> 適合 1～3 人搭乘 </div>
                                        @*人數 / 行李*@
                                        <div class="car-spec-list">
                                            <div class="car-spec">
                                                <i class="bi bi-person-fill"></i>
                                                <span> 3 人 </span>
                                            </div>
                                            <div class="car-spec">
                                                <i class="bi bi-luggage-fill"></i>
                                                <span> 2 件 </span>
                                            </div>
                                        </div>
                                        @*車輛特色*@
                                        <div class="car-features">
                                            <span class="car-feature">
                                                <i class="bi bi-check2"></i> 舒適座椅
                                            </span>
                                            <span class="car-feature">
                                                <i class="bi bi-check2"></i> 冷氣
                                            </span>
                                            <span class="car-feature">
                                                <i class="bi bi-check2"></i> 免費 Wi-Fi
                                            </span>
                                        </div>
                                        @*價格*@
                                        <div class="car-price-wrapper">
                                            <span class="car-price-label"> 接送價格 </span>
                                            <span class="car-price"> 
                                                NT$1,200
                                                <span class="car-price-unit"> 起 </span>
                                            </span>
                                        </div>
                                        @*選擇按鈕*@
                                        <div class="car-select-status">
                                            <i class="bi bi-circle"></i> 選擇此車型
                                        </div>
                                    </div>
                                </div>
                            </div>
                            -->
                        </div>
                    </div>
                </section>

                <!-- 0812 STR ------------------------------------------------------------------------------------------- -->
                <!-- ======================= 人數 / 行李 / 嬰兒座椅 section ======================= -->
                <section class="booking-card" id="passengerSection">
                    <!-- 標題 -->
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-people-fill"></i>
                            乘客資訊
                        </h2>
                        <span class="booking-card-hint">
                            請選擇乘客與行李數量
                        </span>
                    </div>
                    <!-- 內容 -->
                    <div class="booking-card-body">
                        <div class="row g-3">
                            <!-- ======================= 人數 div ======================= -->
                            <div class="col-12 col-md-4">
                                <div class="quantity-field">
                                    <label for="passengerCount" class="form-label">
                                        <i class="bi bi-person-fill"></i>
                                        總人數
                                    </label>
                                    <div class="input-group quantity-input-group">
                                        <!-- 減少 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="passengerMinus" aria-label="減少人數">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <!-- 數量 -->
                                        <input type="number" class="form-control quantity-input" id="passengerCount"
                                               name="passengerCount" value="1" min="1" max="1" inputmode="numeric">
                                        <!-- 增加 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="passengerPlus" aria-label="增加人數">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <div class="quantity-limit" id="passengerLimit">
                                        請先選擇車型
                                    </div>
                                </div>
                            </div>
                            <!-- ======================= 行李 div ======================= -->
                            <div class="col-12 col-md-4">
                                <div class="quantity-field">
                                    <label for="luggageCount" class="form-label">
                                        <i class="bi bi-luggage-fill"></i>
                                        行李
                                    </label>
                                    <div class="input-group quantity-input-group">
                                        <!-- 減少 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="luggageMinus" aria-label="減少行李">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <!-- 數量 -->
                                        <input type="number" class="form-control quantity-input" id="luggageCount"
                                               name="luggageCount" value="0" min="0" max="0" inputmode="numeric">
                                        <!-- 增加 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="luggagePlus" aria-label="增加行李">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <div class="quantity-limit" id="luggageLimit">
                                        請先選擇車型
                                    </div>
                                </div>
                            </div>
                            <!-- ======================= 嬰兒座椅 div ======================= -->
                            <div class="col-12 col-md-4">
                                <div class="quantity-field">
                                    <label for="babySeatCount" class="form-label">
                                            @* <i class="bi bi-person-standing"></i> *@
                                            <i class="bi bi-balloon-fill"></i>
                                        嬰兒座椅
                                    </label>
                                    <div class="input-group quantity-input-group">
                                        <!-- 減少 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="babySeatMinus" aria-label="減少嬰兒座椅">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <!-- 數量 -->
                                        <input type="number" class="form-control quantity-input" id="babySeatCount"
                                               name="babySeatCount" value="0" min="0" max="0" inputmode="numeric">
                                        <!-- 增加 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="babySeatPlus" aria-label="增加嬰兒座椅">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <div class="quantity-limit" id="babySeatLimit">
                                        請先選擇車型
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ======================= 航班資訊 section ======================= -->
                <!-- 0812 END ------------------------------------------------------------------------------------------- -->
            </div>
        

            <div class="col-12">
                <!-- ======================= 訂單總覽 section ======================= -->
                <!-- 舊 -->
                <section class="booking-card summary-card">
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-receipt"></i>
                            訂單總覽
                        </h2>
                    </div>
                    <div class="booking-card-body">
                        <!-- 乘車時間 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-calendar3"></i>
                                乘車時間
                            </div>
                            <div class="summary-value" id="summaryRideTime">
                                尚未選擇
                            </div>
                        </div>
                        <!-- 上車 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-geo-alt"></i>
                                上車地點
                            </div>
                            <div class="summary-value" id="summaryPickup">
                                尚未選擇
                            </div>
                        </div>
                        <!-- 停靠 div -->
                        @* <div class="summary-item">
                            <div class="summary-label">
