                            <div class="summary-value" id="summaryBabySeat">
                                0 張
                            </div>
                        </div>
                        <!-- 航班資訊 / 預設隱藏 div -->
                        <div class="summary-item d-none" id="summaryFlightRow">
                            <div class="summary-label">
                                <i class="bi bi-airplane"></i>
                                航班
                            </div>
                            <div class="summary-value" id="summaryFlight">
                                -
                            </div>
                        </div>
						<!-- ======================= 送出訂單 div ======================= -->
						<!-- 送出訂單 -->
						<div class="order-submit-area">
							<button type="submit"
									class="btn btn-primary order-submit-btn"
									id="submitOrderBtn">
								<i class="bi bi-check-circle-fill"></i>
								<span class="submit-btn-text">
									送出訂單
								</span>

								<span class="spinner-border spinner-border-sm d-none"
										id="submitOrderSpinner"
										role="status"
										aria-hidden="true"></span>
							</button>
							<div class="order-submit-hint">
								<i class="bi bi-shield-check"></i>
								請確認訂單資訊無誤後再送出
							</div>
						</div>
                    </div>
                </section>
            </div>
        </form>
