@{
    // var Drivers = ViewBag.Drivers;  // 測試用
    var VehicleMenu = ViewBag.VehicleMenu;
    var SavedAddresses = ViewBag.SavedAddresses as List<MemberSavedAddress> ?? new List<MemberSavedAddress>();

    @* 我想要一個一個取，取法如下 -> <img src="@vehicleMenuSin[0].ImageUrl"> *@
