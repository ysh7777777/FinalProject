                        <div class="summary-section-title">
                            <i class="bi bi-people-fill"></i>
                            乘客資訊
                        </div>
                        <!-- 人數 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                人數
                            </div>
                            <div class="summary-value" id="summaryPassengers">
                                1 人
                            </div>
                        </div>
                        <!-- 行李 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                行李
                            </div>
                            <div class="summary-value" id="summaryLuggage">
                                0 件
                            </div>
                        </div>
