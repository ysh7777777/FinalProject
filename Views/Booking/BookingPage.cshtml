                                    </label>
                                    <div class="input-group quantity-input-group">
                                        <!-- 減少 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="passengerMinus" aria-label="減少人數">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <!-- 數量 -->
                                        <input type="number" class="form-control quantity-input" id="passengerCount"
                                               name="passengerCount" value="1" min="1" max="1" inputmode="numeric">
                                        <!-- 增加 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="passengerPlus" aria-label="增加人數">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <div class="quantity-limit" id="passengerLimit">
                                        請先選擇車型
                                    </div>
                                </div>
                            </div>
                            <!-- ======================= 行李 div ======================= -->
                            <div class="col-12 col-md-4">
                                <div class="quantity-field">
                                    <label for="luggageCount" class="form-label">
                                        <i class="bi bi-luggage-fill"></i>
                                        行李
                                    </label>
                                    <div class="input-group quantity-input-group">
                                        <!-- 減少 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="luggageMinus" aria-label="減少行李">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <!-- 數量 -->
                                        <input type="number" class="form-control quantity-input" id="luggageCount"
                                               name="luggageCount" value="0" min="0" max="0" inputmode="numeric">
                                        <!-- 增加 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="luggagePlus" aria-label="增加行李">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <div class="quantity-limit" id="luggageLimit">
                                        請先選擇車型
                                    </div>
                                </div>
                            </div>
                            <!-- ======================= 嬰兒座椅 div ======================= -->
                            <div class="col-12 col-md-4">
                                <div class="quantity-field">
                                    <label for="babySeatCount" class="form-label">
                                        <i class="bi bi-person-standing"></i>
                                        嬰兒座椅
                                    </label>
                                    <div class="input-group quantity-input-group">
                                        <!-- 減少 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="babySeatMinus" aria-label="減少嬰兒座椅">
                                            <i class="bi bi-dash-lg"></i>
                                        </button>
                                        <!-- 數量 -->
                                        <input type="number" class="form-control quantity-input" id="babySeatCount"
                                               name="babySeatCount" value="0" min="0" max="0" inputmode="numeric">
                                        <!-- 增加 -->
                                        <button type="button" class="btn btn-outline-secondary quantity-btn"
                                                id="babySeatPlus" aria-label="增加嬰兒座椅">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                    <div class="quantity-limit" id="babySeatLimit">
                                        請先選擇車型
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ======================= 航班資訊 section ======================= -->
                <section class="booking-card" id="flightSection">
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-airplane-fill"></i>
                            航班資訊
                        </h2>
                    </div>
                    <div class="booking-card-body">
                        <!-- 追蹤航班 -->
                        <div class="form-check form-switch flight-track-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="trackFlight"
                                   name="trackFlight">
                            <label class="form-check-label" for="trackFlight">
                                <span class="flight-switch-title">
                                    <i class="bi bi-broadcast"></i>
                                    是否追蹤航班
                                </span>
                                <span class="flight-switch-description">
                                    開啟後我們會依航班資訊追蹤抵達時間
                                </span>
                            </label>
                        </div>
                        <!-- ======================= 航班編號 / 預設隱藏 div ======================= -->
                        <div class="flight-number-wrapper d-none" id="flightNumberWrapper">
                            <label for="flightNumber" class="form-label">
                                航班編號
                                <span class="text-danger">
                                    *
                                </span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-airplane"></i>
                                </span>
                                <input type="text" class="form-control" id="flightNumber" name="flightNumber"
                                       placeholder="例如：BR108" autocomplete="off" maxlength="10">
                            </div>
                            <div class="form-text">
                                請輸入航空公司航班編號，例如 BR108、CI100
                            </div>
                        </div>
                    </div>
                </section>
                <!-- 0812 END ------------------------------------------------------------------------------------------- -->
            </div>
        <form id="bookingForm" class="booking-form" novalidate>

            <div class="col-12">
                <!-- ======================= 訂單總覽 section ======================= -->
                <!-- 舊 -->
                <section class="booking-card summary-card">
                    <div class="booking-card-header">
                        <h2 class="booking-card-title">
                            <i class="bi bi-receipt"></i>
                            訂單總覽
                        </h2>
                    </div>
                    <div class="booking-card-body">
                        <!-- 乘車時間 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-calendar3"></i>
                                乘車時間
                            </div>
                            <div class="summary-value" id="summaryRideTime">
                                尚未選擇
                            </div>
                        </div>
                        <!-- 上車 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-geo-alt"></i>
                                上車地點
                            </div>
                            <div class="summary-value" id="summaryPickup">
                                尚未選擇
                            </div>
                        </div>
                        <!-- 停靠 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-signpost-2"></i>
                                停靠點
                            </div>
                            <div class="summary-value" id="summaryStopover">
                                無
                            </div>
                        </div>
                        <!-- 下車 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-geo-alt-fill"></i>
                                下車地點
                            </div>
                            <div class="summary-value" id="summaryDropoff">
                                尚未選擇
                            </div>
                        </div>
                        <!-- 選車型 div -->
                        <div class="summary-item">
                            <div class="summary-label">
                                <i class="bi bi-car-front"></i>
                                車型
                            </div>
                            <div class="summary-value" id="summaryCar">
                                尚未選擇
                            </div>
                        </div>
                        <!-- =================================== -->
                        <!-- 乘客資訊 div -->
                        <div class="summary-section-title">
                            <i class="bi bi-people-fill"></i>
                            乘客資訊
                        </div>
                        <!-- 人數 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                人數
                            </div>
                            <div class="summary-value" id="summaryPassengers">
                                1 人
                            </div>
                        </div>
                        <!-- 行李 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                行李
                            </div>
                            <div class="summary-value" id="summaryLuggage">
                                0 件
                            </div>
                        </div>
                        <!-- 嬰兒座椅 -->
                        <div class="summary-item">
                            <div class="summary-label">
                                嬰兒座椅
                            </div>
                            <div class="summary-value" id="summaryBabySeat">
                                0 張
                            </div>
                        </div>
                        <!-- 航班資訊 / 預設隱藏 div -->
                        <div class="summary-item d-none" id="summaryFlightRow">
                            <div class="summary-label">
                                <i class="bi bi-airplane"></i>
                                航班
                            </div>
                            <div class="summary-value" id="summaryFlight">
                                -
                            </div>
                        </div>
						<!-- ======================= 送出訂單 div ======================= -->
						<!-- 送出訂單 -->
						<div class="order-submit-area">
							<button type="submit"
									class="btn btn-primary order-submit-btn"
									id="submitOrderBtn">
								<i class="bi bi-check-circle-fill"></i>
								<span class="submit-btn-text">
									送出訂單
								</span>

								<span class="spinner-border spinner-border-sm d-none"
										id="submitOrderSpinner"
										role="status"
										aria-hidden="true"></span>
							</button>
							<div class="order-submit-hint">
								<i class="bi bi-shield-check"></i>
								請確認訂單資訊無誤後再送出
							</div>
						</div>
                    </div>
                </section>
            </div>
        </form>
        </div>
    </main>

    <!-- ======================= << JS 引用 >> ======================= -->
    <!-- ======================= Bootstrap JS ======================= -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ======================= Flatpickr ======================= -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/zh-tw.js"></script>

    <!-- ======================= JS ======================== -->
    <script src="./js/Booking/0810.js"></script>
    <script src="./js/Booking/place-autocomplete.js"></script>
    <!-- 串接地址轉換 API JS ======================== -->
    <script async src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAk5HVk6NmgjgNL9vu5m2HRjvcbghlyMn4&libraries=places&callback=initAutocomplete"></script>
</body>

</html>



