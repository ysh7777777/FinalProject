@{
    ViewData["Title"] ??= "機場接送司機端";
 
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - 機場接送司機端</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/layout-v2.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="layout-v2 driver-v2 d-flex flex-column min-vh-100">

    <!-- 司機端導覽列 -->
    <header class="sticky-top layout-v2-header">

        <nav class="navbar navbar-expand-lg navbar-light driver-v2-nav"
             aria-label="司機端主選單">

            <div class="container-fluid ps-0 pe-3 pe-lg-4">

                <!-- Logo -->
                <a class="navbar-brand py-0 d-flex align-items-center"
                   asp-controller="Driver"
                   asp-action="Index"
                   aria-label="司機端首頁">

                    <img src="~/Images/LOGO.png"
                         class="layout-v2-logo"
                         alt="萬馬接車司機端" />
                </a>

                <!-- 手機版選單按鈕 -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#driverV2Menu"
                        aria-controls="driverV2Menu"
                        aria-expanded="false"
                        aria-label="開啟選單">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- 導覽列選單 -->
                <div class="collapse navbar-collapse"
                     id="driverV2Menu">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Driver"
                               asp-action="Index">
                                司機首頁
                            </a>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button class="nav-link"
                                        type="submit">
                                    登出
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- 頁面內容 -->
    <main class="flex-grow-1 py-4 py-lg-5">
        <div class="container layout-v2-content">
            @RenderBody()
        </div>
    </main>

    <!-- 頁尾 -->
    <footer class="layout-v2-footer py-4 mt-auto">
        <div class="container">

            <div class="row justify-content-center text-center text-md-start gy-2">

                <div class="col-12 col-md-auto">
                    <span class="fw-semibold">萬馬接機</span>
                </div>

                <div class="col-12 col-md-auto">
                    公司統編：85124513
                </div>

                <div class="col-12 col-md-auto">
                    電話號碼：(02)2485-6162
                </div>
            </div>

            <hr class="my-3 opacity-25" />

            <div class="text-center small">
                © 2026 機場接送 · 安心抵達每一段旅程
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
