@{
  var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    //var isAuthenticated = true;
    // isAuthenticated = true;

    var displayName = User
      .FindFirst(System.Security.Claims.ClaimTypes.GivenName)
      ?.Value
      ?? User?.Identity?.Name
      ?? "";

    ViewData["Title"] ??= "機場接送";
    var pageClass = ViewData["PageClass"]?.ToString() ?? "";
    var isHomePage = pageClass == "home-index";

}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 機場接送</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/layout-v2.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-v2 client-v2 d-flex flex-column min-vh-100 @pageClass">
    @* 修改：sticky-top 讓導覽列在捲動畫面時固定在最上方 *@
    <header class="sticky-top layout-v2-header">
        <nav class="navbar navbar-expand-lg navbar-light client-v2-nav" aria-label="乘客端主選單">
            @* 修改：參考圖一，導覽內容使用置中的固定寬度容器 *@
            <div class="container-xl">
                <a class="navbar-brand py-0 d-flex align-items-center" href="/" aria-label="機場接送首頁">
                    <img src="~/Images/LOGO.png" class="layout-v2-logo" alt="萬馬接送" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#clientV2Menu" aria-controls="clientV2Menu" aria-expanded="false" aria-label="開啟選單">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="clientV2Menu">
                    <ul class="navbar-nav ms-lg-auto me-lg-5 align-items-lg-center gap-lg-2">
                        @* 修改：參考圖一，主要功能改為置中的文字選單 *@
                        <li class="nav-item"><a class="nav-link" href="/Booking/BookingPage">點我訂車</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Booking/History">訂單查詢</a></li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="clientV2Member" role="button" data-bs-toggle="dropdown" aria-expanded="false">會員專區</a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="clientV2Member">
                                    <li><a class="dropdown-item" href="/Change">修改密碼</a></li>
                                    <li><a class="dropdown-item" asp-controller="SavedAddress" asp-action="Index">常用地址維護</a></li>
                                    <li><a class="dropdown-item" href="/Booking/History">訂單查詢</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><form action="/Account/Logout" method="post"><button class="dropdown-item" type="submit">登出</button></form></li>
                                </ul>
                            </li>
                            <li class="nav-item ms-lg-2 d-flex align-items-center">
                                <span class="nav-link fw-semibold text-nowrap">
                                    歡迎，@displayName
                                </span>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="btn btn-light btn-sm px-3" href="/login">註冊 / 登入</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="flex-grow-1 @(isHomePage ? "" : "py-4 py-lg-5")">
        <div class="layout-v2-content @(isHomePage ? "container-fluid p-0" : "container")">
            @RenderBody()
        </div>
    </main>
    <footer class="layout-v2-footer py-4 mt-auto">
        <div class="container">
            <div class="row justify-content-center text-center text-md-start gy-2">
                <div class="col-12 col-md-auto">
                    <span class="fw-semibold">萬馬接車</span>
                </div>
                <div class="col-12 col-md-auto">
                    公司統編：85124513
                </div>
                <div class="col-12 col-md-auto">
                    電話號碼：(02)2485-6162
                </div>
            </div>

            <hr class="my-3 opacity-25" />

            <div class="text-center small">
                © 2026 機場接送 · 安心抵達每一段旅程
            </div>
        </div>
    </footer>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

