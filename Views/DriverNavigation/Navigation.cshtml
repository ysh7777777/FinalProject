@{
    ViewData["Title"] = "司機導航";
}

<div class="container-fluid p-0">

    <!-- ========================= -->
    <!-- 地圖 -->
    <!-- ========================= -->

    <div id="driver-map"
         style="width:100%; height:500px;">
    </div>


    <!-- ========================= -->
    <!-- 訂單資料 -->
    <!-- ========================= -->

    <div class="container py-3">

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <h5 class="fw-bold mb-3">
                    目前訂單
                </h5>


                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>訂單編號：</strong>
                        <span id="order-no">
                            R-342827955
                        </span>
                    </div>

                    <div class="col-md-6">
                        <strong>乘客：</strong>
                        <span>
                            王小明
                        </span>
                    </div>

                </div>


                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>出發地：</strong>
                        <span id="pickup-address">
                            桃園國際機場 T2
                        </span>
                    </div>

                    <div class="col-md-6">
                        <strong>目的地：</strong>
                        <span id="destination-address">
                            台中市南屯區公益路二段51號
                        </span>
                    </div>

                </div>


                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>車牌：</strong>
                        NSS-1088
                    </div>

                    <div class="col-md-6">
                        <strong>車資：</strong>
                        1020 元
                    </div>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- GPS 狀態 -->
        <!-- ========================= -->

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">
                        <strong>目前 Latitude：</strong>
                        <span id="driver-lat">
                            尚未上線
                        </span>
                    </div>

                    <div class="col-md-6">
                        <strong>目前 Longitude：</strong>
                        <span id="driver-lng">
                            尚未上線
                        </span>
                    </div>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- 操作按鈕 -->
        <!-- ========================= -->

        <div class="d-flex gap-2 flex-wrap">

            <button id="online-btn"
                    type="button"
                    class="btn btn-success">

                上線

            </button>


            <button id="arrived-passenger-btn"
                    type="button"
                    class="btn btn-primary"
                    disabled>

                已抵達客人位置

            </button>


            <button id="arrived-destination-btn"
                    type="button"
                    class="btn btn-warning"
                    disabled>

                已送達目的地

            </button>

            <button id="next-order-btn" 
                    type="button"
                    class="btn btn-outline-primary" disabled>
                前往下個訂單
            </button>


            <button id="offline-btn"
                    type="button"
                    class="btn btn-danger"
                    disabled>

                下線

            </button>

            

        </div>


        <div class="mt-3">

            <strong>目前狀態：</strong>

            <span id="driver-status"
                  class="badge bg-secondary">

                下線

            </span>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="~/js/driver-navigation.js"></script>

    <script async
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAk5HVk6NmgjgNL9vu5m2HRjvcbghlyMn4&callback=initDriverMap">
    </script>

}