<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>登入畫面</title>

    <!-- 引入 Bootstrap 5 -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet">
    <link href="~/css/Members/Login.css" rel="stylesheet">
</head>

<body class="login-body">
    <div class="login-container">
        <div class="login-row">
            <div class="login-card">

                <!-- 頂部切換按鈕組 -->
                <div class="role-toggle-group" role="group" aria-label="Role login toggle button group">
                    <input type="radio" name="roleRadio" id="passenger-tab" autocomplete="off" onclick="switchRole('Passenger')" checked>
                    <label class="role-toggle-btn" for="passenger-tab">乘客登入</label>

                    <input type="radio" name="roleRadio" id="driver-tab" autocomplete="off" onclick="switchRole('Driver')">
                    <label class="role-toggle-btn" for="driver-tab">司機登入</label>
                </div>

                <!-- 登入表單 -->
                <form action="/Login" method="POST" class="needs-validation" novalidate>

                    <!-- 表單內容內縮 -->
                    <div class="form-content-wrapper">

                        <!-- 帳號區塊 -->
                        <div class="fg-item">
                            <label for="account" class="formLabel-title">帳號<span class="required-star">*</span></label>
                            <div class="input-relative-container">
                                <span class="form-icon-left">
                                    <img src="~/icon/person-fill.svg" alt="帳號圖示" class="icon-img">
                                </span>
                                <input type="text" class="form-control-custom input-with-icon-left" id="account" name="account"
                                       maxlength="6" pattern="[A-Za-z0-9]{6}" placeholder="輸入6位英數" required>
                                <div class="invalid-feedback-custom">請輸入帳號(輸入6位英數)</div>
                            </div>
                        </div>

                        <!-- 密碼區塊 -->
                        <div class="fg-item-small">
                            <label for="password" class="formLabel-title">密碼(區分大小寫)<span class="text-danger">*</span></label>
                            <div class="input-relative-container">
                                <span class="form-icon-left">
                                    <img src="~/icon/key-fill.svg" alt="鑰匙圖示" class="icon-img">
                                </span>

                                <input type="password" class="form-control-custom input-with-icons-both" id="password" name="password"
                                       maxlength="11" pattern="[A-Za-z0-9]{6,11}" required placeholder="請輸入密碼（6~11位英數)">

                                <span class="form-icon-right" id="togglepassword">
                                    <img src="~/icon/eye-fill.svg" alt="顯示密碼" class="icon-img">
                                </span>

                                <div class="invalid-feedback-custom">請輸入密碼（6~11位英數）</div>
                            </div>
                        </div>

                        <!-- 修改密碼連結 -->
                        <div class="forgot-password-wrapper">
                            <a href="/Change" class="forgot-password-link">修改密碼</a>
                        </div>

                        <!-- 註冊按鈕與登入按鈕 並排 -->
                        <div class="button-row">
                            <div class="button-col">
                                <a href="/Join" class="btn-action-outline">註冊</a>
                            </div>
                            <div class="button-col">
                                <button type="submit" class="btn-action-outline">登入</button>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
        </div>
    </div>

    @* <script src="~/js/Members/Login.js"></script> *@
    <!-- 眼睛點擊 -->
    <script src="~/js/Members/icon.js"></script>
</body>
</html>
