                                <i class="bi bi-x-circle"></i>
                                取消訂單
                            </button>
                            <button class="btn btn-driver" type="button" onclick="showDriverStatus('R-342827955')">
                                <i class="bi bi-person-badge"></i>
                                司機狀態
                            </button>
                        </div>
                    </div>
                </div>

                @* 分隔線 *@
                <div class="order-divider"></div>
                @* 展開按鈕 *@
                <button class="expand-button" type="button" onclick="toggleOrder(this)" aria-label="展開訂單詳細資訊">
                    <i class="bi bi-chevron-down"></i>
                </button>
                @* 訂單摘要 *@
                <div class="order-extra">
                    <div class="row g-2 order-detail">
                        @* 車牌 / 車型 *@
                        <div class="col-6 col-md-3">
                            <div class="detail-item">
                                <div class="detail-title">
                                    <i class="bi bi-car-front"></i>
                                    車牌 / 車型
                                </div>
                                <div class="detail-content">
                                    ER-57825
                                    <br>
                                    白色 賓士九人座
                                </div>
                            </div>
                        </div>
                        @* 人數 / 行李 *@
                        <div class="col-6 col-md-3">
                            <div class="detail-item">
                                <div class="detail-title">
                                    <i class="bi bi-people"></i>
                                    人數 / 行李
                                </div>
                                <div class="detail-content">
                                    5 人
                                    <br>
                                    6 行李
                                </div>
                            </div>
                        </div>
                        @* 費用 *@
                        <div class="col-6 col-md-3">
                            <div class="detail-item">
                                <div class="detail-title">
                                    <i class="bi bi-currency-dollar"></i>
                                    費用
                                </div>
                                <div class="detail-content price">NT$ 30,000</div>
                            </div>
                        </div>
                        @* 行程時間 *@
                        <div class="col-6 col-md-3">
                            <div class="detail-item">
                                <div class="detail-title">
                                    <i class="bi bi-hourglass-split"></i>
                                    預計行程時間
                                </div>
                                <div class="detail-content">120 分鐘</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            -->
        
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ======================= JS ======================== -->
    <script src="~/js/ClientHistory_New/ClientHistory_New.js"></script>
</body>

</html>

