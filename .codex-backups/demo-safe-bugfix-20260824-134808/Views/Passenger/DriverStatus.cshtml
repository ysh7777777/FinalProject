@model FinalProject.Models.Trip

@{
    ViewData["Title"] = "司機狀態";
    var fare =
            (Model?.LicensePlateNavigation?.BaseFare ?? 0)
            + (Model?.EstimatedDuration ?? 0) * 20;
}


<div class="container py-4">

    <div class="mb-3">

        <h2 class="fw-bold">
            司機狀態
        </h2>

        <p class="text-muted">
            可查看目前司機位置與行程狀態。
        </p>

    </div>


    <!-- ========================= -->
    <!-- 地圖 -->
    <!-- ========================= -->

    <div id="passenger-map"
         class="border rounded"
         style="width:100%; height:500px;">
    </div>


    <!-- ========================= -->
    <!-- 司機資料 -->
    <!-- ========================= -->

    <div class="card shadow-sm mt-3">

        <div class="card-body">

            <div class="row mb-2">

                <div class="col-md-6">

                    <strong>訂單編號：</strong>
                    <span id="passenger-order-no">
                        @Model?.OrderNo
                    </span>

                </div>

                


                <div class="col-md-6">

                    <strong>車牌：</strong>
                    <span>
                        @Model?.LicensePlate
                    </span>

                </div>

            </div>


            <div class="row mb-2">

                <div class="col-md-6">

                    <strong>車型：</strong>
                    <span>
                        @Model?.VehicleType
                    </span>

                </div>


                <div class="col-md-6">

                    <strong>車資：</strong>
                    <span>
                        @fare 元
                    </span>

                </div>

            </div>


            <div class="row mb-2">

                <div class="col-md-6">

                    <strong>目的地：</strong>
                    <span id="passenger-destination">
                        @Model?.Destination
                    </span>

                </div>

                <div class="col-md-6">

                    <strong>司機：</strong>
                    <span id="driver-name">
                        @Model?.AssignedDriver?.DriverName
                    </span>

                </div>

            </div>


            <div class="row">

                <div class="col-md-6">

                    <strong>目前狀態：</strong>

                    <span id="passenger-trip-status"
                          class="badge bg-secondary">

                        等待司機上線

                    </span>

                </div>


                <div class="col-md-6">

                    <strong>司機位置更新：</strong>

                    <span id="last-update">
                        尚未收到資料
                    </span>

                </div>

            </div>

            <div class="row mt-3">

                <div class="col-md-4">
                    <strong>目前路線：</strong>
                    <span id="passenger-route-target">
                        等待司機分享位置
                    </span>
                </div>

                <div class="col-md-4">
                    <strong>剩餘距離：</strong>
                    <span id="passenger-route-distance">
                        尚未取得
                    </span>
                </div>

                <div class="col-md-4">
                    <strong>預計抵達時間：</strong>
                    <span id="passenger-route-eta">
                        尚未取得
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>
<script>
    window.passengerTripData = {
        orderNo: "@Model?.OrderNo",
        driverId: "@Model?.AssignedDriverId",
        pickupLat: @((Model?.PickupLat ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),
        pickupLng: @((Model?.PickupLng ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),
        destinationLat: @((Model?.DestinationLat ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),
        destinationLng: @((Model?.DestinationLng ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))
        };
</script>

@section Scripts {



   
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/passenger-driver-status.js"></script>

    <script async
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAk5HVk6NmgjgNL9vu5m2HRjvcbghlyMn4&callback=initPassengerMap">
    </script>

    

}
