@model FinalProject.Models.Trip
@{
    ViewData["Title"] = "司機導航";
}




@{
    var fare =
        (Model?.LicensePlateNavigation?.BaseFare ?? 0)
        + (Model?.EstimatedDuration ?? 0) * 20;
}



<button id="tempnshare-btn"
        type="button"
        class="">

    測試訂單開始前40分鐘

</button>

<button id="tempyshare-btn"
        type="button"
        class="">

    測試訂單開始前20分鐘

</button>

<div class="container-fluid p-0">

    <!-- ========================= -->
    <!-- 地圖 -->
    <!-- ========================= -->

    <div id="driver-map"
         style="width:100%; height:500px;">
    </div>


    <!-- ========================= -->
    <!-- 訂單資料 -->
    <!-- ========================= -->

    <div class="container py-3">

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <h5 class="fw-bold mb-3">
                    目前訂單
                </h5>


                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>訂單編號：</strong>
                        <span id="order-no">
                            @Model?.OrderNo
                        </span>
                    </div>

                    <div class="col-md-6">
                        <strong>乘客：</strong>
                        <span>
                            @Model?.AccountNavigation?.FullName
                        </span>
                    </div>

                </div>


                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>出發地：</strong>
                        <span id="pickup-address">
                            @Model?.PickupLocation
                        </span>
                    </div>

                    <div class="col-md-6">
                        <strong>目的地：</strong>
                        <span id="destination-address">
                            @Model?.Destination
                        </span>
                    </div>

                 
                </div>


                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>車牌：</strong>
                        @Model?.LicensePlate
                    </div>

                    <div class="col-md-6">
                        <strong>車資：</strong>
                        @fare 元
                    </div>

                   

                </div>
                <div class="row mb-2">

                    <div class="col-md-6">
                        <strong>乘客乘車時間：</strong>
                        <span id="departure-time">
                            @Model?.DepartureTime 
                        </span>
                    </div>


                    <div class="col-md-6">
                        <strong>訂單狀態</strong>
                        <span id="order-status">
                            @Model?.TripStatus
                        </span>
                    </div>
                </div>


            </div>

        </div>


        <!-- ========================= -->
        <!-- GPS 狀態 -->
        <!-- ========================= -->

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <div class="row" style="display:none;">

                    <div class="col-md-6">
                        <strong>目前 Latitude：</strong>
                        <span id="driver-lat">
                            尚未上線
                        </span>
                    </div>

                    <div class="col-md-6">
                        <strong>目前 Longitude：</strong>
                        <span id="driver-lng">
                            尚未上線
                        </span>
                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-4">
                        <strong>目前前往：</strong>
                        <span id="driver-route-target">
                            等待司機上線
                        </span>
                    </div>

                    <div class="col-md-4">
                        <strong>剩餘距離：</strong>
                        <span id="driver-route-distance">
                            尚未取得
                        </span>
                    </div>

                    <div class="col-md-4">
                        <strong>預計抵達時間：</strong>
                        <span id="driver-route-eta">
                            尚未取得
                        </span>
                    </div>

                </div>

            </div>
           

        </div>


        <!-- ========================= -->
        <!-- 操作按鈕 -->
        <!-- ========================= -->

        <div class="d-flex gap-2 flex-wrap">
            <button id="temproute-btn"
                    type="button"
                    class=""
                    >

                測試行徑路線功能

            </button>

          

            <button id="online-btn"
                    type="button"
                    class="btn btn-success">

                上線

            </button>


            <button id="arrived-passenger-btn"
                    type="button"
                    class="btn btn-primary"
                    disabled>

                已抵達客人位置

            </button>


            <button id="arrived-destination-btn"
                    type="button"
                    class="btn btn-warning"
                    disabled>

                已送達目的地

            </button>

            <button id="last-order-btn"
                    type="button"
                    class="btn btn-outline-primary"
                    disabled="@(
                    ViewBag.IsHistory == true
                        ? !(ViewBag.HasOlderOrder ?? false)
                        : !(ViewBag.HasCompletedToday ?? false)
                    )">
                查看上個訂單
            </button>

            <button id="nextpage-order-btn"
                    type="button"
                    class="btn btn-outline-primary"
                    style="display:@(ViewBag.IsHistory == true ? "inline-block" : "none");">
                下一頁
            </button>

            <button id="next-order-btn" 
                    type="button"
                    class="btn btn-outline-primary"
                    disabled>
                前往下個訂單
            </button>

            



            <button id="offline-btn"
                    type="button"
                    class="btn btn-danger"
                    disabled>

                下線

            </button>

            

        </div>


        <div class="mt-3">

            <strong>目前狀態：</strong>

            <span id="driver-status"
                  class="badge bg-secondary">

                下線

            </span>

        </div>

    </div>

</div>

<script>
    window.tripData = {
        driverId: "@Model?.AssignedDriverId",

        orderNo: "@Model?.OrderNo",

        isHistory: @(ViewBag.IsHistory == true ? "true" : "false"),

        tripStatus: "@Model?.TripStatus",

        pickupLat: @((Model?.PickupLat ?? 0)
                                .ToString(System.Globalization.CultureInfo.InvariantCulture)),

        pickupLng: @((Model?.PickupLng ?? 0)
                                .ToString(System.Globalization.CultureInfo.InvariantCulture)),

        destinationLat: @((Model?.DestinationLat ?? 0)
                                .ToString(System.Globalization.CultureInfo.InvariantCulture)),

        destinationLng: @((Model?.DestinationLng ?? 0)
                                .ToString(System.Globalization.CultureInfo.InvariantCulture)),

        departureTime: "@(Model?.DepartureTime?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")"
    };
</script>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="~/js/driver-navigation.js"></script>

    <script async
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAk5HVk6NmgjgNL9vu5m2HRjvcbghlyMn4&callback=initDriverMap">
    </script>

}
@if (TempData["OrderMessage"] != null)
{
    <script>
        alert('@Html.Raw(TempData["OrderMessage"])');
    </script>
}
